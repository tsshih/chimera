cpu: CPU.RiscV32 @ sysbus
    cpuType: "rv32imac_zicsr_zifencei"
    PerformanceInMips: 80
    timeProvider: clint
    allowUnalignedAccesses: true

xipflash: Memory.MappedMemory @ sysbus 0x80000000
    size: 0x400000

itcm: Memory.MappedMemory @ sysbus 0x80400000
    size: 0x400000

clint: IRQControllers.CoreLevelInterruptor @ sysbus 0x02000000
    [0,1] -> cpu@[3,7]
    frequency: 80000000
    numberOfTargets: 1

plic: IRQControllers.PlatformLevelInterruptController @ sysbus 0x0C000000
    0 -> cpu@11
    numberOfSources: 1023
    numberOfContexts: 1
    prioritiesEnabled: true

uart0: UART.NS16550 @ sysbus 0x10000000
